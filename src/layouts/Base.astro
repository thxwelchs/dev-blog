---
interface Props {
  title?: string;
  description?: string;
  wide?: boolean;
  image?: string;
  type?: string;
}
const {
  title = 'thxwelchs',
  description = '끄적끄적',
  wide = false,
  image = '/img/welchs-icon.png',
  type = 'website',
} = Astro.props;
const path = Astro.url.pathname;
const isActive = (p: string) => (p === '/' ? path === '/' : path.startsWith(p));
const SITE = Astro.site ?? new URL('https://thxwelchs.github.io');
const canonical = new URL(path, SITE).href;
const ogImage = new URL(image, SITE).href;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="thxwelchs" href="/rss.xml" />
    <link rel="icon" type="image/png" href="/img/welchs-icon.png" />

    <meta property="og:site_name" content="thxwelchs" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body>
    <header class="site-header container">
      <a href="/" class="brand">
        <img src="/img/welchs-icon.png" alt="" class="brand-ico" />
        <span>thxwelchs</span>
      </a>
      <nav class="nav">
        <a href="/category/엔지니어링/" class:list={[{ on: isActive('/category/엔지니어링') }]}>엔지니어링</a>
        <a href="/category/PS/" class:list={[{ on: isActive('/category/PS') }]}>PS</a>
        <a href="/series/" class:list={[{ on: isActive('/series') }]}>Series</a>
        <a href="/tags/" class:list={[{ on: isActive('/tags') }]}>Tags</a>
      </nav>
      <form class="search" action="/search/" method="get" role="search">
        <input type="search" name="q" placeholder="검색…" aria-label="검색" />
      </form>
    </header>

    <main class:list={['container', { wide }]}>
      <slot />
    </main>

    <footer class="site-footer container">
      <span>© thxwelchs</span>
    </footer>

    <style is:global>
      :root {
        --ink: #1a1a1a;
        --sub: #8a8f98;
        --line: #ececec;
        --accent: #2b6cb0;
        --bg: #fff;
        --maxw: 880px;
        --mono: ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, monospace;
      }
      * { box-sizing: border-box; }
      html { font-size: 62.5%; -webkit-text-size-adjust: 100%; }
      body {
        margin: 0;
        color: var(--ink);
        background: var(--bg);
        font-family: -apple-system, BlinkMacSystemFont, 'Apple SD Gothic Neo',
          'Pretendard', 'Segoe UI', Roboto, sans-serif;
        font-size: 1.7rem;
        line-height: 1.75;
        letter-spacing: -0.01em;
      }
      a { color: inherit; text-decoration: none; }

      .container { max-width: var(--maxw); margin: 0 auto; padding: 0 24px; }
      .container.wide { max-width: 1320px; }

      /* 헤더: 심플, 좌측 브랜드 + 우측 작은 메뉴 */
      .site-header {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 16px;
        padding-top: 40px;
        padding-bottom: 36px;
        flex-wrap: wrap;
      }
      .brand { display: flex; align-items: center; gap: 9px; font-size: 1.9rem; font-weight: 700; letter-spacing: -0.02em; }
      .brand-ico { width: 26px; height: 26px; border-radius: 6px; object-fit: cover; }
      .nav { display: flex; align-items: center; gap: 18px; margin-left: auto; }
      .nav a { color: var(--sub); font-size: 1.5rem; transition: color 0.15s; }
      .nav a:hover, .nav a.on { color: var(--ink); }
      .site-header .search { margin-left: 18px; }
      .site-header .search input {
        width: 150px;
        padding: 6px 12px;
        border: 1px solid var(--line);
        border-radius: 6px;
        background: #fff;
        font-family: var(--mono);
        font-size: 1.25rem;
        color: var(--ink);
        outline: none;
        transition: width 0.2s, border-color 0.2s;
      }
      .site-header .search input::placeholder { color: var(--sub); }
      .site-header .search input:focus { width: 200px; border-color: var(--ink); }

      main.container { padding-top: 8px; padding-bottom: 80px; min-height: 60vh; }

      /* 글 목록(카드 스택) */
      .post-list { list-style: none; margin: 0; padding: 0; }
      .page-title { font-size: 2.4rem; letter-spacing: -0.02em; margin: 0 0 20px; }
      .page-title .cnt { color: var(--sub); font-size: 1.7rem; }

      .site-footer {
        color: var(--sub);
        padding-top: 40px;
        padding-bottom: 48px;
        font-size: 1.3rem;
        border-top: 1px solid var(--line);
        margin-top: 40px;
      }

      /* 글 본문 */
      .post h1 { font-size: 3.2rem; line-height: 1.25; letter-spacing: -0.03em; margin: 0 0 10px; }
      .post .cover { width: 100%; border-radius: 10px; margin: 22px 0; }
      .post .content { margin-top: 28px; font-size: 1.7rem; }
      .post .content > * + * { margin-top: 1.3em; }
      .post .content img { max-width: 100%; border-radius: 8px; }
      .post .content h1 { font-size: 2.4rem; margin-top: 2em; letter-spacing: -0.02em; }
      .post .content h2 { font-size: 2.05rem; margin-top: 1.8em; }
      .post .content h3 { font-size: 1.8rem; margin-top: 1.6em; }
      .post .content pre { padding: 16px 18px; border-radius: 10px; overflow: auto; font-size: 1.45rem; line-height: 1.6; }
      .post .content :not(pre) > code {
        background: #f3f4f6; padding: 1px 6px; border-radius: 5px; font-size: 0.9em;
      }
      .post .content table {
        width: 100%;
        border-collapse: collapse;
        margin: 1.3em 0;
        font-size: 1.5rem;
        display: block;
        overflow-x: auto;
      }
      .post .content th, .post .content td {
        border: 1px solid var(--line);
        padding: 8px 12px;
        text-align: left;
        white-space: nowrap;
      }
      .post .content thead th { background: #f6f7f9; font-weight: 700; }
      .post .content tbody tr:nth-child(even) { background: #fafbfc; }
      .post .content blockquote {
        margin: 1.3em 0; padding: 2px 0 2px 18px;
        border-left: 3px solid var(--line); color: #555;
      }
      .post .content a { color: var(--accent); text-decoration: underline; text-underline-offset: 2px; }
      .meta { color: var(--sub); font-size: 1.4rem; }
    </style>
  </body>
</html>
