---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { tagSlug } from '../../lib/text';

const all = await getCollection('blog', ({ data }) => !data.draft);
const counts: Record<string, number> = {};
all.forEach(p => p.data.tags.forEach(t => (counts[t] = (counts[t] || 0) + 1)));
const tags = Object.entries(counts).sort((a, b) => b[1] - a[1]);
---

<Base title="Tags">
  <h1 class="page-title">Tags</h1>
  <div class="cloud">
    {
      tags.map(([tag, n]) => (
        <a href={`/tags/${tagSlug(tag)}/`}>
          {tag}
          <span class="c">{n}</span>
        </a>
      ))
    }
  </div>
</Base>

<style>
  .page-title { font-size: 2.6rem; margin: 0 0 18px; }
  .cloud { display: flex; flex-wrap: wrap; gap: 12px; }
  .cloud a {
    padding: 6px 14px; border: 1px solid #d9dde2; border-radius: 20px;
    color: #333; font-size: 1.45rem; transition: border-color .2s, color .2s;
  }
  .cloud a:hover { border-color: #3b6ee0; color: #3b6ee0; }
  .cloud a .c { margin-left: 6px; color: #aab0b8; font-size: 1.25rem; }
</style>
