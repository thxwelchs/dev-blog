<style>
  .nf { text-align: center; padding: 80px 0; }
  .nf h1 { font-size: 6rem; margin: 0; color: #3b6ee0; }
  .nf p { color: #6a7178; }
  .nf a { display: inline-block; margin-top: 16px; color: #3b6ee0; }
</style>
